// Pulse — MEDD Lab Management System
// Prisma schema (Postgres 17). See IMPLEMENTATION_PLAN_v5.md §3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleScope {
  GLOBAL
  LAB
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DeskStatus {
  ACTIVE
  MAINTENANCE
}

enum BookingType {
  DESK
  REMOTE
}

enum OccurrenceStatus {
  SCHEDULED
  CANCELLED
}

enum WorkMode {
  ONSITE
  REMOTE
  LEAVE
}

enum AttendanceMode {
  SELF
  MANUAL
  NONE
}

enum Recurrence {
  ONCE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum LogStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum RevisionKind {
  CREATED
  EDITED
  SUBMITTED
  REVIEWED
  RETURNED
  DELETED
  RESTORED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  DONE
}

// ─── Roles (admin-managed, granular permissions) ───

model Role {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false)
  scope       RoleScope @default(LAB)
  permissions String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
}

// ─── People & auth ───

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  emailVerified      DateTime?   @db.Timestamptz()
  image              String?
  passwordHash       String
  roleId             String
  role               Role        @relation(fields: [roleId], references: [id])
  status             UserStatus  @default(ACTIVE)
  phone              String?
  joinDate           DateTime?   @db.Date
  exitDate           DateTime?   @db.Date
  attendanceTracking Boolean     @default(true)
  attendanceModeOverride AttendanceMode?
  linkAttendanceToBooking Boolean @default(true)
  // UI accent color choice (null = app default).
  accentColor      String?
  labId              String?
  lab                Lab?        @relation("HomeLab", fields: [labId], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  bookings        Booking[]
  createdBookings Booking[]          @relation("CreatedBookings")
  attendance      AttendanceRecord[]
  logEntries      LogEntry[]
  reviewedEntries LogEntry[]         @relation("ReviewedEntries")
  revisionsAuthored LogEntryRevision[] @relation("RevisionActor")
  assignedTodos   Todo[]             @relation("AssignedTodos")
  createdTodos    Todo[]             @relation("CreatedTodos")
  ledProjects     Project[]          @relation("LedProjects")
  memberships     ProjectMember[]
  auditEvents     AuditLog[]
  inchargeOf      LabIncharge[]
  workingDayExceptions WorkingDayException[]
  markerForLabs   Lab[]              @relation("LabAttendanceMarker")
}

// Extra working days for a user (industrial visits, presentation days, …),
// each optionally recurring. Combined with booking-linked days these define
// the user's working days for attendance.
model WorkingDayException {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date
  recurrence Recurrence @default(ONCE)
  note       String?
  createdAt  DateTime   @default(now())

  @@index([userId, date])
}

// App-wide key/value settings editable by admin (app name, …).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Auth.js v5 uses the Credentials provider with the JWT session strategy,
// so no adapter tables are needed. User carries passwordHash + role directly.



// ─── Organization & labs ───

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  labs      Lab[]
}

model Lab {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attendanceMode     AttendanceMode @default(SELF)
  attendanceMarkerId String?
  attendanceMarker   User?          @relation("LabAttendanceMarker", fields: [attendanceMarkerId], references: [id], onDelete: SetNull)

  desks     Desk[]
  projects  Project[]
  members   User[]        @relation("HomeLab")
  incharges LabIncharge[]
  floorplanImage FloorplanImage?
  floorplanShapes FloorplanShape[]
}

model LabIncharge {
  labId  String
  userId String
  lab    Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([labId, userId])
}

// ─── Desks ───

model Desk {
  id          String     @id @default(cuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id], onDelete: Cascade)
  label       String
  status      DeskStatus @default(ACTIVE)
  notes       String?
  // Floorplan position as % of image dimensions (null = not placed).
  xPct        Float?
  yPct        Float?
  // Marker shape on the floorplan layout.
  markerShape DeskMarkerShape @default(CIRCLE)
  bookings    Booking[]
  occurrences BookingOccurrence[]

  @@unique([labId, label])
}

// One layout image per lab, stored as bytes so it works on read-only hosts.
model FloorplanImage {
  id        String   @id @default(cuid())
  labId     String   @unique
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  width     Int?
  height    Int?
  updatedAt DateTime @updatedAt
}

enum FloorplanShapeKind {
  WALL
  ZONE
  RECTANGLE
  CIRCLE
  POLYGON
}

enum DeskMarkerShape {
  CIRCLE
  SQUARE
  ROUNDED
}

// Shapes drawn on a lab's floorplan (% coordinates).
// Rect-likes (WALL/ZONE/RECTANGLE/CIRCLE) use x/y/w/h; POLYGON additionally
// stores its vertices in `points` ([{x, y}, ...], % coords).
model FloorplanShape {
  id     String             @id @default(cuid())
  labId  String
  lab    Lab                @relation(fields: [labId], references: [id], onDelete: Cascade)
  kind   FloorplanShapeKind
  xPct   Float
  yPct   Float
  wPct   Float
  hPct   Float
  label  String?
  color  String?
  points Json?
  // Polygon style: filled (like a zone) or outline only (like a wall).
  filled Boolean           @default(true)
}

// ─── Bookings ───

model Booking {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  type            BookingType @default(DESK)
  deskId          String?
  desk            Desk?       @relation(fields: [deskId], references: [id])
  title           String?
  projectId       String?
  project         Project?    @relation(fields: [projectId], references: [id])
  timeStart       String
  timeEnd         String
  isRecurring     Boolean     @default(false)
  daysOfWeek      Int[]
  validFrom       DateTime    @db.Date
  validTo         DateTime?   @db.Date
  trackAttendance Boolean?
  notes           String?
  createdById     String
  createdBy       User        @relation("CreatedBookings", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())

  occurrences BookingOccurrence[]

  @@index([userId, validFrom])
}

model BookingOccurrence {
  id         String           @id @default(cuid())
  bookingId  String
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  deskId     String?
  desk       Desk?            @relation(fields: [deskId], references: [id])
  date       DateTime         @db.Date
  startsAt   DateTime         @db.Timestamptz()
  endsAt     DateTime         @db.Timestamptz()
  status     OccurrenceStatus @default(SCHEDULED)
  cancelNote String?

  @@index([deskId, date])
  @@index([bookingId, date])

  // NOTE: overlap protection lives in migration 20261006200000_no_double_booking
  // (EXCLUDE USING gist on deskId + tstzrange, partial to SCHEDULED rows with a
  // desk). Prisma's PSL cannot express it, so it is managed as raw SQL there.
}

// ─── Attendance ───

model AttendanceRecord {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  date      DateTime  @db.Date
  checkIn   DateTime? @db.Timestamptz()
  checkOut  DateTime? @db.Timestamptz()
  workMode  WorkMode  @default(ONSITE)
  deskId    String?
  bookingId String?
  note      String?

  @@unique([userId, date])
  @@index([date])
}

// ─── Logbook ───

model LogEntry {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id])
  date          DateTime  @db.Date
  summary       String
  details       String?   @db.Text
  status        LogStatus @default(DRAFT)
  reviewedById  String?
  reviewedBy    User?     @relation("ReviewedEntries", fields: [reviewedById], references: [id])
  reviewedAt    DateTime? @db.Timestamptz()
  reviewComment String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Soft delete: entries are never hard-deleted; deletion is a revision.
  deletedAt     DateTime? @db.Timestamptz()
  revisionCount Int       @default(0)
  revisions     LogEntryRevision[]

  @@index([userId, date])
  @@index([projectId, date])
}

// Immutable snapshot of a log entry at one point in its history.
// A revision is recorded for every create, edit, status transition,
// deletion, and restore — so the full story of an entry is preserved.
model LogEntryRevision {
  id          String       @id @default(cuid())
  entryId     String
  entry       LogEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  revisionNo  Int
  kind        RevisionKind
  // Snapshot of the entry *after* this revision was applied.
  summary     String
  details     String?      @db.Text
  projectId   String?
  projectName String?
  date        DateTime     @db.Date
  status      LogStatus
  // Who made this change (name snapshotted so history survives user deletion).
  actorId     String?
  actor       User?        @relation("RevisionActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName   String
  // Optional editor note / delete reason / review comment.
  note        String?
  createdAt   DateTime     @default(now()) @db.Timestamptz()

  @@unique([entryId, revisionNo])
  @@index([entryId])
}

// ─── Projects ───

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  labId       String
  lab         Lab           @relation(fields: [labId], references: [id])
  status      ProjectStatus @default(PLANNING)
  leadId      String?
  lead        User?         @relation("LedProjects", fields: [leadId], references: [id])
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  createdAt   DateTime      @default(now())
  // False = kanban columns show date order; set true on first manual drag.
  kanbanOrdered Boolean     @default(false)

  members    ProjectMember[]
  milestones Milestone[]
  todos      Todo[]
  logEntries LogEntry[]
  bookings   Booking[]
}

model ProjectMember {
  projectId String
  userId    String
  role      String  @default("member")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?         @db.Text
  startDate   DateTime?       @db.Date
  dueDate     DateTime?       @db.Date
  status      MilestoneStatus @default(PLANNED)
  sortOrder   Int             @default(0)
  todos       Todo[]

  // Finish-to-Start dependencies between milestones.
  prerequisites MilestoneDependency[] @relation("MilestoneDependents")
  dependents    MilestoneDependency[] @relation("MilestonePrerequisites")
}

model Todo {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title       String
  description String?    @db.Text
  status      TodoStatus @default(TODO)
  assigneeId  String?
  assignee    User?      @relation("AssignedTodos", fields: [assigneeId], references: [id], onDelete: SetNull)
  startDate   DateTime?  @db.Date
  endDate     DateTime?  @db.Date
  sortOrder   Int        @default(0)
  createdById String
  createdBy   User       @relation("CreatedTodos", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  // Finish-to-Start dependencies: this todo starts after its prerequisites finish.
  prerequisites TodoDependency[] @relation("TodoDependents")
  dependents    TodoDependency[] @relation("TodoPrerequisites")

  @@index([projectId, status, sortOrder])
}

// Finish-to-Start: todoId starts after dependsOnId finishes.
model TodoDependency {
  todoId      String
  dependsOnId String
  todo        Todo   @relation("TodoDependents", fields: [todoId], references: [id], onDelete: Cascade)
  dependsOn   Todo   @relation("TodoPrerequisites", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([todoId, dependsOnId])
  @@index([dependsOnId])
}

// Finish-to-Start: milestoneId starts after dependsOnId finishes.
model MilestoneDependency {
  milestoneId String
  dependsOnId String
  milestone   Milestone @relation("MilestoneDependents", fields: [milestoneId], references: [id], onDelete: Cascade)
  dependsOn   Milestone @relation("MilestonePrerequisites", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([milestoneId, dependsOnId])
  @@index([dependsOnId])
}

// ─── Audit log ───

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz()

  @@index([entityType, entityId])
  @@index([createdAt])
}
