// Pulse — MEDD Lab Management System
// Prisma schema (Postgres 17). See IMPLEMENTATION_PLAN_v5.md §3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleScope {
  GLOBAL
  LAB
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DeskStatus {
  ACTIVE
  MAINTENANCE
}

enum BookingType {
  DESK
  REMOTE
}

enum OccurrenceStatus {
  SCHEDULED
  CANCELLED
}

enum WorkMode {
  ONSITE
  REMOTE
  LEAVE
}

enum LogStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  DONE
}

// ─── Roles (admin-managed, granular permissions) ───

model Role {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false)
  scope       RoleScope @default(LAB)
  permissions String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
}

// ─── People & auth ───

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  emailVerified      DateTime?   @db.Timestamptz()
  image              String?
  passwordHash       String
  roleId             String
  role               Role        @relation(fields: [roleId], references: [id])
  status             UserStatus  @default(ACTIVE)
  phone              String?
  joinDate           DateTime?   @db.Date
  exitDate           DateTime?   @db.Date
  attendanceTracking Boolean     @default(true)
  labId              String?
  lab                Lab?        @relation("HomeLab", fields: [labId], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  bookings        Booking[]
  createdBookings Booking[]          @relation("CreatedBookings")
  attendance      AttendanceRecord[]
  logEntries      LogEntry[]
  reviewedEntries LogEntry[]         @relation("ReviewedEntries")
  assignedTodos   Todo[]             @relation("AssignedTodos")
  createdTodos    Todo[]             @relation("CreatedTodos")
  ledProjects     Project[]          @relation("LedProjects")
  memberships     ProjectMember[]
  auditEvents     AuditLog[]
  inchargeOf      LabIncharge[]
}

// Auth.js v5 uses the Credentials provider with the JWT session strategy,
// so no adapter tables are needed. User carries passwordHash + role directly.



// ─── Organization & labs ───

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  labs      Lab[]
}

model Lab {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  desks     Desk[]
  projects  Project[]
  members   User[]        @relation("HomeLab")
  incharges LabIncharge[]
}

model LabIncharge {
  labId  String
  userId String
  lab    Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([labId, userId])
}

// ─── Desks ───

model Desk {
  id          String     @id @default(cuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id], onDelete: Cascade)
  label       String
  status      DeskStatus @default(ACTIVE)
  notes       String?
  bookings    Booking[]
  occurrences BookingOccurrence[]

  @@unique([labId, label])
}

// ─── Bookings ───

model Booking {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  type            BookingType @default(DESK)
  deskId          String?
  desk            Desk?       @relation(fields: [deskId], references: [id])
  title           String?
  projectId       String?
  project         Project?    @relation(fields: [projectId], references: [id])
  timeStart       String
  timeEnd         String
  isRecurring     Boolean     @default(false)
  daysOfWeek      Int[]
  validFrom       DateTime    @db.Date
  validTo         DateTime?   @db.Date
  trackAttendance Boolean?
  notes           String?
  createdById     String
  createdBy       User        @relation("CreatedBookings", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())

  occurrences BookingOccurrence[]

  @@index([userId, validFrom])
}

model BookingOccurrence {
  id         String           @id @default(cuid())
  bookingId  String
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  deskId     String?
  desk       Desk?            @relation(fields: [deskId], references: [id])
  date       DateTime         @db.Date
  startsAt   DateTime         @db.Timestamptz()
  endsAt     DateTime         @db.Timestamptz()
  status     OccurrenceStatus @default(SCHEDULED)
  cancelNote String?

  @@index([deskId, date])
  @@index([bookingId, date])

  // NOTE: overlap protection lives in migration 20261006200000_no_double_booking
  // (EXCLUDE USING gist on deskId + tstzrange, partial to SCHEDULED rows with a
  // desk). Prisma's PSL cannot express it, so it is managed as raw SQL there.
}

// ─── Attendance ───

model AttendanceRecord {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  date      DateTime  @db.Date
  checkIn   DateTime? @db.Timestamptz()
  checkOut  DateTime? @db.Timestamptz()
  workMode  WorkMode  @default(ONSITE)
  deskId    String?
  bookingId String?
  note      String?

  @@unique([userId, date])
  @@index([date])
}

// ─── Logbook ───

model LogEntry {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id])
  date          DateTime  @db.Date
  summary       String
  details       String?   @db.Text
  status        LogStatus @default(DRAFT)
  reviewedById  String?
  reviewedBy    User?     @relation("ReviewedEntries", fields: [reviewedById], references: [id])
  reviewedAt    DateTime? @db.Timestamptz()
  reviewComment String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, date])
  @@index([projectId, date])
}

// ─── Projects ───

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  labId       String
  lab         Lab           @relation(fields: [labId], references: [id])
  status      ProjectStatus @default(PLANNING)
  leadId      String?
  lead        User?         @relation("LedProjects", fields: [leadId], references: [id])
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  createdAt   DateTime      @default(now())

  members    ProjectMember[]
  milestones Milestone[]
  todos      Todo[]
  logEntries LogEntry[]
  bookings   Booking[]
}

model ProjectMember {
  projectId String
  userId    String
  role      String  @default("member")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?         @db.Text
  dueDate     DateTime?       @db.Date
  status      MilestoneStatus @default(PLANNED)
  sortOrder   Int             @default(0)
  todos       Todo[]

  // Finish-to-Start dependencies between milestones.
  prerequisites MilestoneDependency[] @relation("MilestoneDependents")
  dependents    MilestoneDependency[] @relation("MilestonePrerequisites")
}

model Todo {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title       String
  description String?    @db.Text
  status      TodoStatus @default(TODO)
  assigneeId  String?
  assignee    User?      @relation("AssignedTodos", fields: [assigneeId], references: [id], onDelete: SetNull)
  startDate   DateTime?  @db.Date
  endDate     DateTime?  @db.Date
  sortOrder   Int        @default(0)
  createdById String
  createdBy   User       @relation("CreatedTodos", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  // Finish-to-Start dependencies: this todo starts after its prerequisites finish.
  prerequisites TodoDependency[] @relation("TodoDependents")
  dependents    TodoDependency[] @relation("TodoPrerequisites")

  @@index([projectId, status, sortOrder])
}

// Finish-to-Start: todoId starts after dependsOnId finishes.
model TodoDependency {
  todoId      String
  dependsOnId String
  todo        Todo   @relation("TodoDependents", fields: [todoId], references: [id], onDelete: Cascade)
  dependsOn   Todo   @relation("TodoPrerequisites", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([todoId, dependsOnId])
  @@index([dependsOnId])
}

// Finish-to-Start: milestoneId starts after dependsOnId finishes.
model MilestoneDependency {
  milestoneId String
  dependsOnId String
  milestone   Milestone @relation("MilestoneDependents", fields: [milestoneId], references: [id], onDelete: Cascade)
  dependsOn   Milestone @relation("MilestonePrerequisites", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([milestoneId, dependsOnId])
  @@index([dependsOnId])
}

// ─── Audit log ───

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz()

  @@index([entityType, entityId])
  @@index([createdAt])
}
