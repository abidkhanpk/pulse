# ─── Pulse — environment variables ───
# Copy to .env and fill in real values. .env is gitignored and never committed.

# Postgres connection (local dev):
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://pulse:change-me@localhost:5432/pulse_dev

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Public URL of the app (used by Auth.js for callbacks)
AUTH_URL=http://localhost:3000

# Lab timezone for display
TZ=Asia/Karachi
